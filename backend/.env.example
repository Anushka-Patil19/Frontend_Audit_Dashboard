# Microsoft Graph app registration used by the Mail connector's server-side
# client_credentials token exchange (app/clients/graph_auth.py).
# Copy this file to .env and fill in real values — .env is git-ignored.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: a real mailbox to verify actual mail access against (not just
# directory access). Only a received-timestamp is surfaced to the UI, never
# subject/body content.
MS_TEST_MAILBOX=
# CP38/CP10 shared inbox that receives sign-off/approval emails. Falls back
# to MS_TEST_MAILBOX if unset.
MS_SHARED_MAILBOX=

# Jira Cloud REST v3, Basic auth (account email + API token). Used by both
# CP10 (CAB approval status) and CR-compliance (Jira approval status).
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=

# GitHub REST v3. Optional — public repos work without it, just at a much
# lower unauthenticated rate limit (60 requests/hr).
GITHUB_TOKEN=

# Groq API key (free tier), used only for the CP38/CP10 sign-off language
# classification step (never for the deterministic sender check). Hosts
# OpenAI's open-weight gpt-oss-20b model. Get one at console.groq.com.
GROQ_API_KEY=

# The frontend's origin, for CORS. Set to the deployed frontend's real
# origin in production.
FRONTEND_ORIGIN=http://localhost:8080

# Directory evidence screenshots are written to/read from, relative to
# wherever the backend process runs (or an absolute path).
EVIDENCE_DIR=evidence

# JSON file developer invites are stored in (relative to the backend process).
# Invite emails are sent via Microsoft Graph from MS_SHARED_MAILBOX (falls back
# to MS_TEST_MAILBOX) — the app registration needs Mail.Send (Application).
INVITES_FILE=invites.json

# Enable Graph emails to the role addresses configured in Escalations.
# Leave false during testing; the feature does not send when disabled.
ESCALATION_EMAIL_LIVE=false
ESCALATIONS_FILE=escalations.json

# Saved Outlook on the web login used to screenshot the real email in Outlook
# as evidence. Create it once with `python -m scripts.outlook_login`. Without
# it, the email is re-rendered from Graph instead.
OUTLOOK_SESSION_FILE=outlook_session.json
