+
+// SAATHI and MPS reuse PIT Armour's mock data shape with their own components, people and
+// change keys, so each tab reads like its own project. Only PIT Armour has live hooks.
+function rebrand<T>(x: T, map: [string, string][]): T {
+  let json = JSON.stringify(x);
+  for (const [from, to] of map) json = json.split(from).join(to);
+  return JSON.parse(json) as T;
+}
+
+export type ManagerProject = {
