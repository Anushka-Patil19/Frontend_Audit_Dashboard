+  ["PIT Armour", "MPS"], ["CR-POC", "CR-MPS"], ["@Kunal", "@Abhishek"],
+];
+
+const shiftScores = (list: Component[], by: number): Component[] =>
+  list.map((c) => ({
+    ...c,
+    score: Math.min(99, c.score + by),
+    trend: c.trend.map((v) => Math.min(99, v + by)),
+    nc: by >= 8 ? Math.max(0, c.nc - 1) : c.nc,
+    overdue: by >= 8 ? Math.max(0, c.overdue - 1) : c.overdue,
+  }));
+
+function variant(pid: ProjectId, name: string, bu: string, map: [string, string][], scoreBy: number, scoreHistory: number[], lastStep: number, flowBy: number): ManagerProject {
+  return {
+    pid, name, bu, replace: map, scoreHistory, lastStep,
+    components: shiftScores(rebrand(COMPONENTS, map), scoreBy),
+    team: rebrand(TEAM, map),
+    decisions: rebrand(DECISIONS, map).map((d) => ({ ...d, id: `${pid}-${d.id}` })).slice(0, 3),
+    offences: rebrand(REPEAT_OFFENCES, map).map((o) => ({ ...o, times: Math.max(1, o.times - (scoreBy >= 8 ? 1 : 0)) })),
+    activity: rebrand(LEAD_ACTIVITY, map),
+    flow: FLOW_WEEKS.map((w) => ({ ...w, opened: Math.max(1, w.opened - flowBy) })),
+    backlogStart: Math.max(4, BACKLOG_START - flowBy * 2),
+    aging: AGING.map((a, i) => ({ ...a, count: Math.max(0, a.count - (i === 0 ? 0 : flowBy)) })),
+  };
+}
