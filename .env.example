# Microsoft Graph app registration used by the Mail connector's server-side
# client_credentials token exchange (src/lib/mail-connector.ts).
# Copy this file to .env and fill in real values — .env is git-ignored.
# NEVER commit real values, and never prefix these with VITE_ (that would
# ship them into the client bundle).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: a real mailbox to verify actual mail access against (not just
# directory access). Only a received-timestamp is surfaced to the UI, never
# subject/body content.
MS_TEST_MAILBOX=
# CP38 shared inbox that receives UAT sign-off emails. Falls back to
# MS_TEST_MAILBOX if unset.
MS_SHARED_MAILBOX=
# Groq API key (free tier), used only for the CP38 sign-off language
# classification step (never for the deterministic sender check). Hosts
# OpenAI's open-weight gpt-oss-20b model. Get one at console.groq.com.
GROQ_API_KEY=
# Optional: GitHub Personal Access Token used by the dependency version
# checker (src/lib/github-client.ts, npm run check-deps) to read
# requirements.txt via the GitHub REST API. Public repos work without it,
# just at a much lower unauthenticated rate limit (60 requests/hr).
GITHUB_TOKEN=
