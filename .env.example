# Microsoft Graph app registration used by the Mail connector's server-side
# client_credentials token exchange (src/lib/mail-connector.ts).
# Copy this file to .env and fill in real values — .env is git-ignored.
# NEVER commit real values, and never prefix these with VITE_ (that would
# ship them into the client bundle).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: a real mailbox to verify actual mail access against (not just
# directory access). Only a received-timestamp is surfaced to the UI, never
# subject/body content.
MS_TEST_MAILBOX=
# CP38 shared inbox that receives UAT sign-off emails. Falls back to
# MS_TEST_MAILBOX if unset.
MS_SHARED_MAILBOX=
# Groq API key (free tier), used only for the CP38 sign-off language
# classification step (never for the deterministic sender check). Hosts
# OpenAI's open-weight gpt-oss-20b model. Get one at console.groq.com.
GROQ_API_KEY=

# GitHub PAT used by the CR-compliance checkpoint (src/lib/github-client.ts)
# to read branches and pull requests. Needs only read access to the repo(s)
# configured in src/lib/cr-compliance-config.ts (Contents + Pull requests:
# read-only, for a fine-grained token).
GITHUB_TOKEN=

# Jira Cloud REST auth (Basic: account email + API token) used by the
# CR-compliance checkpoint (src/lib/jira-client.ts) to read ticket status.
# Deliberately separate from CP10's Rovo MCP OAuth flow — a static API
# token, no `npm run atlassian:login` step needed. Create a token at
# id.atlassian.com/manage-profile/security/api-tokens.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
